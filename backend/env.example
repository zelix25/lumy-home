# Application
# development | production | test
NODE_ENV=development
PORT=3000
# Pour Docker, utilisez l'URL interne : http://frontend:80
# Pour le développement local, utilisez : http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_PATH=data/homehub.db

# MQTT (Zigbee2MQTT)
# Pour Docker, utilisez l'URL interne : mqtt://mosquitto:1883
# Pour le développement local, utilisez : mqtt://localhost:1883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=homehub-backend
MQTT_RECONNECT_PERIOD=5000

# Logging
# debug | info | warn | error
LOG_LEVEL=info

# AI (Gemma 3 via Ollama)
# Pour Docker, utilisez l'URL interne : http://ollama:11434
# Pour le développement local, utilisez : http://localhost:11434
LLAMA_API_URL=http://localhost:11434
LLAMA_MODEL=gemma3
USE_LOCAL_LLAMA=true

# Auth
# ⚠️ Changez cette clé en production !
JWT_SECRET=homehub-secret-key-change-in-production
JWT_EXPIRES_IN=7d
ENABLE_LOCAL_MODE=true

