# API Backend URL
# En production Docker, utilisez un chemin relatif /api (nginx fait le proxy)
# Pour le développement local, utilisez : http://localhost:3000/api
# VITE_API_URL=/api

# WebSocket URL
# En production Docker, utilisez un chemin relatif /socket.io (nginx fait le proxy)
# Pour le développement local, utilisez : ws://localhost:3000
# VITE_WS_URL=/socket.io

# Url Lumy Store
VITE_STORE_URL=https://store.lumy-home.com