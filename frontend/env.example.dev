# API Backend URL
# Pour le développement local, utilisez : http://localhost:3000/api (avec le préfixe /api)
# Si non défini, le proxy Vite sera utilisé avec le chemin relatif /api
VITE_API_URL=http://localhost:3000/api

# WebSocket URL
# Pour le développement local, utilisez : ws://localhost:3000
VITE_WS_URL=ws://localhost:3000

